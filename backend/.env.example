# =============================================================================
#  Insurance Policy Analyser: configuration
#  Copy this file to backend/.env and fill in STEP 1-3. Restart the backend after changes.
# =============================================================================


# -----------------------------------------------------------------------------
#  STEP 1: Choose the chat LLM (answers the questions)
# -----------------------------------------------------------------------------
#  Provider        LLM_PROVIDER    Example LLM_MODEL          Key to fill in STEP 2
#  -------------   -------------   ------------------------   -------------------------------
#  Anthropic       anthropic       claude-sonnet-5-5          ANTHROPIC_API_KEY
#  OpenAI          openai          gpt-4.1                    OPENAI_API_KEY
#  Google Gemini   google_genai    gemini-2.5-pro             GOOGLE_API_KEY   (*)
#  Groq            groq            llama-3.3-70b-versatile    GROQ_API_KEY     (*)
#  Mistral         mistralai       mistral-large-latest       MISTRAL_API_KEY  (*)
#  Ollama (local)  ollama          qwen2.5:14b                no key; set OLLAMA_BASE_URL (*)
#  Offline test    fake            (anything)                 no key; answers just echo the best excerpt
#
#  (*) needs an extra package: pip install langchain-google-genai / langchain-groq /
#      langchain-mistralai / langchain-ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5

# Vision model that reads charts and figures. Leave both blank to reuse the chat LLM above.
# It must accept images (Claude, GPT-4.1/4o, Gemini all do; most Groq/Ollama text models don't).
VISION_PROVIDER=
VISION_MODEL=


# -----------------------------------------------------------------------------
#  STEP 2: Paste your API keys
#  Only fill the keys for the providers you picked in STEP 1 and STEP 3; leave the rest empty.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------------------
#  STEP 3: Choose the embedding provider (turns the document into vectors)
# -----------------------------------------------------------------------------
#  NOTE: Anthropic has no embeddings API. If you use Claude for chat you still need
#  one of these (OpenAI is the simplest), or "fake" to try the app offline.
#
#  Provider   EMBED_PROVIDER   Example EMBED_MODEL        Key used from STEP 2
#  --------   --------------   ------------------------   ---------------------
#  OpenAI     openai           text-embedding-3-small     OPENAI_API_KEY
#  Voyage     voyage           voyage-3.5                 VOYAGE_API_KEY  (pip install langchain-voyageai)
#  Cohere     cohere           embed-v4.0                 COHERE_API_KEY  (pip install langchain-cohere)
#  Offline    fake             (anything)                 none (random vectors: keyword search still works)
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# Optional reranker for better ordering of retrieved passages: none | cohere (uses COHERE_API_KEY)
RERANK_PROVIDER=none


# -----------------------------------------------------------------------------
#  Optional: observability and answer evaluation (see docs/OBSERVABILITY.md)
# -----------------------------------------------------------------------------
# MASTER SWITCH. false = no tracing and no answer scoring at all (zero extra tokens).
OBSERVABILITY_ENABLED=true

# Self-hosted Langfuse (infra/langfuse). Leave the keys empty to turn tracing and live scoring off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Live LLM-as-judge scoring (groundedness, context/answer relevance, confidence). THIS is what costs
# tokens: one judge call per answer that re-reads the answer and all retrieved sources (~5-8k tokens).
# false = traces still record the free scores (citations, retrieval strength, not-in-document).
EVAL_ENABLED=true
EVAL_SAMPLE_RATE=1.0           # fraction of answers to score (0.0-1.0)
# Blank = same provider as the chat LLM, using its cheaper model
# (openai -> gpt-4.1-mini, anthropic -> claude-haiku-5-5, google_genai -> gemini-2.5-flash).
JUDGE_PROVIDER=
JUDGE_MODEL=


# -----------------------------------------------------------------------------
#  Optional: ingestion and session settings (defaults are fine)
# -----------------------------------------------------------------------------
PARSER=docling
ENABLE_OCR=true                # OCR scanned / image-only pages
ENABLE_VISION=true             # describe charts with the vision model (one LLM call per figure)
ENABLE_TABLE_SUMMARIES=true    # one LLM call per table, improves table retrieval
ENABLE_LLM_TAGGING=false       # LLM fallback for section tagging (keyword tagging is always on)
MAX_UPLOAD_MB=25
MAX_PAGES=400
SESSION_TTL_MINUTES=120        # uploaded documents are deleted from memory after this idle time
